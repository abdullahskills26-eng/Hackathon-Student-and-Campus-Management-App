# SkillBridge backend configuration
# Copy to .env and fill in. .env is gitignored; this example is not.

# ---------------------------------------------------------------- Firebase
# Absolute path to the Firebase service-account JSON.
# Firebase console -> Project settings -> Service accounts -> Generate new
# private key. This file IS a secret: keep it out of the repository.
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\serviceAccountKey.json

# Alternative name the app also reads, if you prefer it.
# FIREBASE_CREDENTIALS=C:\path\to\serviceAccountKey.json

# Without either variable the SDK falls back to Application Default
# Credentials, which you can set up with:
#   gcloud auth application-default login

# ----------------------------------------------------------------- Server
HOST=127.0.0.1
PORT=8000

# ------------------------------------------------------------------- CORS
# Comma-separated origins allowed to call this API.
# "*" is fine for local development; narrow it before deploying.
CORS_ORIGINS=*

# ------------------------------------------------------------------ Rules
# Attendance percentage below which a student is flagged as at-risk.
ATTENDANCE_RISK_THRESHOLD=75
